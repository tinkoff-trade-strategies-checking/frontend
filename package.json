{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "prestart": "npm run api:gen",
    "start": "ng serve",
    "build": "npm run api:gen && ng build",
    "pretest": "npm run api:gen",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:sync": "node scripts/api.mjs sync",
    "api:check": "node scripts/api.mjs check",
    "api:gen": "node scripts/api.mjs gen",
    "check": "npm run format:check && npm run lint && npm run api:check && npm run test && npm run build"
  },
  "private": true,
  "packageManager": "npm@11.21.2",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@taiga-ui/cdk": "^5.33.0",
    "@taiga-ui/core": "^5.33.0",
    "@taiga-ui/icons": "^5.33.0",
    "@taiga-ui/kit": "^5.33.0",
    "@taiga-ui/styles": "^5.33.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "less": "^4.2.0",
    "ng-openapi-gen": "^1.1.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": "^22.12.0"
  }
}
